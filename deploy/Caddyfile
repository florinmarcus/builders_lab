# HTTPS in front of the MCP server. Certificates from Let's Encrypt (TLS_DIRECTIVE = your email),
# or Caddy's own local certificate for testing (TLS_DIRECTIVE = internal).
# Logs: JSON on stdout (shipped to CloudWatch on the server). The MCP path secret (also under /planning) and key
# headers are masked in every log line, including errors from the reverse proxy.
{
	admin off
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp ^(/planning)?/mcp/[^/?]+ ${1}/mcp/<path-secret>
				request>headers>Authorization delete
				request>headers>X-Api-Key delete
			}
		}
	}
}

{$DOMAIN} {
	tls {$TLS_DIRECTIVE}
	encode gzip
	request_body {
		max_size 256KB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp ^(/planning)?/mcp/[^/?]+ ${1}/mcp/<path-secret>
				request>headers>Authorization delete
				request>headers>X-Api-Key delete
			}
		}
	}
	# planning-harvest MCP server (its own project on this server, ADR 0024): /planning/mcp/<key> -> planning-mcp:8090
	handle_path /planning/* {
		reverse_proxy planning-mcp:8090
	}
	handle {
		reverse_proxy app:8000
	}
}
