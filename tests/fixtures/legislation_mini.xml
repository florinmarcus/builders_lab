<ukm:Metadata><dc:title>The Demo Regulations 2010</dc:title><dc:modified>2026-11-06</dc:modified></ukm:Metadata>
<Secondary>
<Body>
  <Part id="part-1" RestrictExtent="E+W">
    <Number>PART 1</Number><Title>General</Title>
    <P1group><Title>Citation</Title>
      <P1 id="regulation-1" DocumentURI="http://www.legislation.gov.uk/uksi/2010/9999/regulation/1/2026-11-06">
        <Pnumber>1</Pnumber>
        <P1para><Text>These Regulations may be cited as the Demo Regulations 2010.</Text></P1para>
      </P1>
    </P1group>
    <P1group><Title>Interpretation</Title>
      <P1 id="regulation-2" DocumentURI="http://www.legislation.gov.uk/uksi/2010/9999/regulation/2/2026-11-06">
        <Pnumber>2</Pnumber>
        <P1para>
          <P2 id="regulation-2-1"><Pnumber>1</Pnumber>
            <P2para><Text>In these Regulations—</Text>
              <UnorderedList Decoration="none" Class="Definition">
                <ListItem><Para><Text>“<Term id="term-the-act">the Act</Term>” means the Building Act 1984;</Text></Para></ListItem>
                <ListItem><Para><Text><Addition ChangeId="k1-1" CommentaryRef="key-f1">“</Addition><Term><Addition ChangeId="k1-1" CommentaryRef="key-f1">relevant building</Addition></Term><Addition ChangeId="k1-1" CommentaryRef="key-f1">” means a building of 11 metres or more;</Addition></Text></Para></ListItem>
              </UnorderedList>
            </P2para>
          </P2>
        </P1para>
      </P1>
    </P1group>
  </Part>
  <Part id="part-2" RestrictExtent="E+W">
    <Number>PART 2</Number><Title>Control of building work</Title>
    <Chapter id="part-2-chapter-1"><Number>CHAPTER 1</Number><Title>Duties</Title>
      <P1group AltVersionRefs="v1" RestrictExtent="E"><Title>Requirements</Title>
        <P1 id="regulation-4" DocumentURI="http://www.legislation.gov.uk/uksi/2010/9999/regulation/4/england/2026-11-06">
          <Pnumber><CommentaryRef Ref="key-f2"/>4</Pnumber>
          <P1para>
            <P2 id="regulation-4-1"><Pnumber>1</Pnumber>
              <P2para><Text>Building work shall comply with <CitationSubRef URI="http://www.legislation.gov.uk/id/uksi/2010/9999/schedule/1" SectionRef="schedule-1">Schedule 1</CitationSubRef> and section 1 of the <Citation URI="http://www.legislation.gov.uk/id/ukpga/1984/55" Class="UnitedKingdomPublicGeneralAct" Year="1984" Number="55">Building Act 1984</Citation>.</Text></P2para>
            </P2>
            <P2 id="regulation-4-2"><Pnumber>2</Pnumber>
              <P2para><Text>Work under <CitationSubRef URI="http://www.legislation.gov.uk/id/uksi/2010/9999/regulation/4/1" SectionRef="regulation-4-1">paragraph (1)</CitationSubRef> includes—</Text>
                <P3 id="regulation-4-2-a"><Pnumber>a</Pnumber><P3para><Text>new buildings; and</Text></P3para></P3>
                <P3 id="regulation-4-2-b"><Pnumber>b</Pnumber><P3para><Text><Substitution ChangeId="k3-1" CommentaryRef="key-f3">extensions</Substitution>.</Text></P3para></P3>
              </P2para>
            </P2>
          </P1para>
        </P1>
      </P1group>
    </Chapter>
    <P1group RestrictExtent="E+W"><Title>Revoked duty</Title>
      <P1 id="regulation-5" Status="Repealed"><Pnumber>5</Pnumber>
        <P1para><Text><Repeal ChangeId="k4-1" CommentaryRef="key-f4">. . .</Repeal></Text></P1para>
      </P1>
    </P1group>
  </Part>
</Body>
<Schedules RestrictExtent="E+W" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <Schedule id="schedule-1" RestrictExtent="E+W">
    <Number>SCHEDULE 1</Number><TitleBlock><Title>Requirements</Title></TitleBlock>
    <ScheduleBody>
      <Tabular><Title>PART B FIRE SAFETY</Title><xhtml:table><xhtml:tbody>
        <xhtml:tr><xhtml:th>Requirement</xhtml:th><xhtml:th>Limits on application</xhtml:th></xhtml:tr>
        <xhtml:tr><xhtml:th colspan="2"><Strong>Means of warning and escape</Strong></xhtml:th></xhtml:tr>
        <xhtml:tr><xhtml:td><P><BlockText><Para><Text><Strong>B1</Strong>.—(1) The building shall be designed for early warning of fire.</Text></Para></BlockText></P>
          <P><BlockText><Para><Text>(a) in all buildings; and</Text></Para></BlockText></P></xhtml:td>
          <xhtml:td><P><BlockText><Para><Text>Requirement B1 does not apply to prisons.</Text></Para></BlockText></P></xhtml:td></xhtml:tr>
        <xhtml:tr><xhtml:td><P><BlockText><Para><Text><Strong>External fire spread</Strong></Text></Para></BlockText></P>
          <P><BlockText><Para><Text><Strong>B4</Strong>.—(1) The external walls shall resist the spread of fire.</Text></Para></BlockText></P></xhtml:td><xhtml:td/></xhtml:tr>
      </xhtml:tbody></xhtml:table></Tabular>
      <Tabular><Title>PART M ACCESS</Title><xhtml:table><xhtml:tbody>
        <xhtml:tr><xhtml:th colspan="2"><Strong>Access and use</Strong></xhtml:th></xhtml:tr>
        <xhtml:tr><xhtml:td><P><BlockText><Para><Text><Strong>M1</Strong>. Reasonable provision shall be made for access.<CommentaryRef Ref="key-m-e"/></Text></Para></BlockText></P></xhtml:td><xhtml:td/></xhtml:tr>
      </xhtml:tbody></xhtml:table></Tabular>
      <Tabular><Title>PART M ACCESS</Title><xhtml:table><xhtml:tbody>
        <xhtml:tr><xhtml:th colspan="2"><Strong>Access and use</Strong></xhtml:th></xhtml:tr>
        <xhtml:tr><xhtml:td><P><BlockText><Para><Text><Strong>M1</Strong>. Reasonable provision must be made for access in Wales.<CommentaryRef Ref="key-m-w"/></Text></Para></BlockText></P>
          <P><BlockText><Para><Text><Strong>Category 1 - visitable dwelling</Strong></Text></Para></BlockText></P>
          <P><BlockText><Para><Text>M4(1). Reasonable provision must be made for visitors.</Text></Para></BlockText></P></xhtml:td><xhtml:td/></xhtml:tr>
      </xhtml:tbody></xhtml:table></Tabular>
      <Tabular><Title>PART S CHARGING</Title><xhtml:table><xhtml:tbody>
        <xhtml:tr><xhtml:th colspan="2"><Strong>New residential buildings</Strong></xhtml:th></xhtml:tr>
        <xhtml:tr><xhtml:td><P><BlockText><Para><Text>S1</Text></Para></BlockText></P>
          <P><BlockText><Para><Text>(1) A new residential building must have a charge point.</Text></Para></BlockText></P></xhtml:td><xhtml:td/></xhtml:tr>
      </xhtml:tbody></xhtml:table></Tabular>
      <Tabular><xhtml:table><xhtml:tbody>
        <xhtml:tr><xhtml:th colspan="2"><Strong>PART T TOILET ACCOMMODATION</Strong></xhtml:th></xhtml:tr>
        <xhtml:tr><xhtml:td><P><BlockText><Para><Text>Toilet accommodation must consist of single-sex toilets.</Text></Para></BlockText></P></xhtml:td><xhtml:td/></xhtml:tr>
      </xhtml:tbody></xhtml:table></Tabular>
    </ScheduleBody>
  </Schedule>
  <Schedule id="schedule-2" RestrictExtent="E+W">
    <Number>SCHEDULE 2</Number><TitleBlock><Title>Exempt buildings</Title></TitleBlock>
    <ScheduleBody>
      <Part id="schedule-2-part-1"><Number><Strong>CLASS 1</Strong></Number>
        <P1group><Title>Buildings controlled elsewhere</Title>
          <P1 id="schedule-2-part-1-paragraph-1" RestrictExtent="E" AltVersionRefs="v2"><Pnumber>1</Pnumber>
            <P1para><Text>A building subject to other law.</Text></P1para></P1>
        </P1group>
      </Part>
    </ScheduleBody>
  </Schedule>
  <Schedule id="schedule-3" Status="Repealed">
    <Number>SCHEDULE 3</Number><TitleBlock><Title>Old forms</Title></TitleBlock>
    <ScheduleBody><P1 id="schedule-3-paragraph-1"><Pnumber>1</Pnumber><P1para><Text>. . .</Text></P1para></P1></ScheduleBody>
  </Schedule>
