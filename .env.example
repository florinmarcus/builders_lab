# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres@localhost:5432/builders

# Builder's Gmail inbox and the addresses allowed to drive the live simulator (ADR 0005)
BUILDER_INBOX=
SIMULATOR_SENDERS=

# MCP server (demo: no login; every call acts for this mock firm. Real use needs OAuth.)
DEMO_FIRM_SLUG=oakline
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_PER_MINUTE=60
# Public host name(s) of the tunnel, comma-separated, e.g. abc.trycloudflare.com
ALLOWED_HOSTS=
