# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres@localhost:5432/builders

# Builder's Gmail inbox and the addresses allowed to drive the live simulator (ADR 0005)
BUILDER_INBOX=
SIMULATOR_SENDERS=

# MCP server security (ADR 0007). Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_PEPPER=
MCP_PATH_SECRET=
SUPPORT_CONTACT=Florin
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_PER_MINUTE=60
# Public host name(s) of the tunnel, comma-separated, e.g. abc.trycloudflare.com
ALLOWED_HOSTS=
